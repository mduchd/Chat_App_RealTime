# Development values only. Override locally as needed; never commit .env.
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_DATABASE=chat_realtime
MYSQL_USER=chat_user
MYSQL_PASSWORD=local_chat_password
MYSQL_PORT=3307
APP_PORT=8080
# For local HTTP development. Production cross-site cookies require None and Secure.
SESSION_COOKIE_SAME_SITE=Lax
SESSION_COOKIE_SECURE=false
